# 앱 주소 (OAuth 콜백 URL을 만들 때 사용)
APP_URL=http://localhost:3000

# GitHub App 설정 화면의 값
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# https://github.com/apps/<slug> 의 <slug>
GITHUB_APP_SLUG=

# 세션 쿠키 암호화 키 (32바이트, base64url)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Claude API 키 (경력기술서 생성). https://platform.claude.com 에서 발급
ANTHROPIC_API_KEY=
# 1이면 Claude를 부르지 않고 개발용 가짜 초안을 보낸다 (키가 없는 개발 환경에서는 자동으로 켜짐)
RESUME_MOCK=
